// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  mobile    String   @unique
  email     String?  @unique
  password  String   @default("")
  role      String   @default("PATIENT") // PATIENT, DOCTOR, ADMIN, STAFF
  photoUrl  String?  // admin's own profile photo — patients/doctors use their profile-table column instead
  termsAcceptedAt DateTime? // set when the patient/doctor accepts the Terms of Service + Privacy Policy gate
  deletedAt DateTime?
  // Bumped to revoke every session at once (logout-all, password change,
  // delete, suspend). Sessions carry it as the JWT `tv` claim.
  tokenVersion Int @default(0)
  // A provider (doctor/nurse) who tapped "Go offline": no new bookings from
  // anyone until this instant — the end of that IST day, so they're back
  // tomorrow without remembering to switch it off (src/lib/timeOff.ts).
  offlineUntil DateTime?
  // UI and push language: "en-IN" | "hi-IN" | "mr-IN" (src/lib/appLanguage.ts).
  // The `doconclick_lang` cookie mirrors it for page rendering; pushes —
  // often sent with no request from this user — read it from here.
  language     String  @default("en-IN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  nurseProfile   NurseProfile?
  asPatient      Appointment[]   @relation("PatientAppointments")
  asDoctor       Appointment[]   @relation("DoctorAppointments")
  complaints     Complaint[]
  reviewsGiven   Review[]        @relation("PatientReviews")
  reviewsReceived Review[]       @relation("DoctorReviews")
  messagesSent   Message[]       @relation("SentMessages")
  settlements       Settlement[] @relation("DoctorSettlements")
  settlementsAdmined Settlement[] @relation("AdminSettlements")
  payoutRequests    PayoutRequest[] @relation("DoctorPayoutRequests")
  duesPayments      DuesPayment[]   @relation("DoctorDuesPayments")
  timeOff           ProviderTimeOff[] @relation("ProviderTimeOff")
  paymentLogs       DoctorPaymentLog[] @relation("DoctorPaymentLogs")
  savedDoctors      SavedDoctor[] @relation("PatientSavedDoctors")
  savedByPatients   SavedDoctor[] @relation("DoctorSavedBy")
  clinics           Clinic[]      @relation("DoctorClinics")
  pushTokens        PushToken[]
  wallet            Wallet?
  walletTransactionsAdjusted WalletTransaction[] @relation("WalletAdjustedBy")
  announcementsCreated   Announcement[]          @relation("AnnouncementsCreated")
  announcementRecipients AnnouncementRecipient[] @relation("AnnouncementRecipients")
  impersonationsStarted  ImpersonationLog[]      @relation("ImpersonationsStarted")
  impersonationsReceived ImpersonationLog[]      @relation("ImpersonationsReceived")
  couponsCreated         Coupon[]               @relation("CouponsCreatedByAdmin")
  couponRedemptions      CouponRedemption[]
  paymentOrders          PaymentOrder[]         @relation("PatientPaymentOrders")
  documents              PatientDocument[]      @relation("PatientDocuments")
  nursePaymentLogs       NursePaymentLog[]      @relation("NursePaymentLogs")
  vitals                 VitalReading[]         @relation("PatientVitals")
  vitalsRecorded         VitalReading[]         @relation("VitalsRecordedBy")
  staffAccount           StaffProfile?           @relation("StaffAccount")
  staffMembers           StaffProfile[]          @relation("DoctorStaff")
  changeRequests         DoctorChangeRequest[]   @relation("DoctorChangeRequests")
  changeRequestsResolved DoctorChangeRequest[]   @relation("ChangeRequestsResolvedBy")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  createdAt DateTime @default(now())
}

model SavedDoctor {
  id        String   @id @default(cuid())
  patientId String
  patient   User     @relation("PatientSavedDoctors", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User     @relation("DoctorSavedBy", fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([patientId, doctorId])
}

model PatientProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  age      Int
  gender   String
  location String?

  homeAddress           String?
  landmark              String?
  pinCode               String?
  bloodGroup            String?
  height                Int?
  weight                Int?
  allergies             String?
  chronicDiseases       String?
  medications           String?
  surgeries             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  photoUrl              String?
  lat                   Float?
  lng                   Float?

  // How far the patient wants to look for doctors, in km. null = "Any
  // distance" (no limit). Applied everywhere doctors are listed — map,
  // assistant, saved list, booking — except that doctors offering video
  // are always shown (video doesn't depend on distance).
  searchRadiusKm        Int?

  dependents PatientDependent[]
}

model PatientDependent {
  id               String   @id @default(cuid())
  patientProfileId String
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  name             String
  relation         String   // Spouse, Son, Daughter, Father, Mother, Other
  age              Int?
  gender           String?
  bloodGroup       String?
  height           Int?
  weight           Int?
  allergies        String?
  chronicDiseases  String?
  medications      String?
  surgeries        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt        DateTime @default(now())
  appointments     Appointment[]
  vitals           VitalReading[]
}

// A patient's general health-records vault — lab reports, scans, discharge
// summaries, vaccination cards etc. kept outside of any one appointment
// (which already has its own PrescriptionAttachment list for visit-specific
// files). Lives on User directly, like Appointment.patientId, rather than
// PatientProfile, since a record shouldn't depend on that row existing.
model PatientDocument {
  id        String   @id @default(cuid())
  patientId String
  patient   User     @relation("PatientDocuments", fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  category  String   @default("Other") // Lab Report, Prescription, Scan/X-ray, Vaccination, Discharge Summary, Other
  fileUrl   String
  fileName  String?
  createdAt DateTime @default(now())
  // Nurse bookings that attached this as the doctor's prescription.
  nurseBookings Appointment[] @relation("NurseBookingPrescription")
}

model DoctorProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl      String?
  qualification String?
  medRegNo      String? @unique
  specialty     String  @default("General Physician")
  experience    Int     @default(0)
  consultFee    Float   @default(0)
  videoFee      Float   @default(0)
  homeVisitFee  Float   @default(0)
  availability  String  @default("Mon-Fri, 9AM-5PM")
  radius        Int     @default(10)
  lat           Float?
  lng           Float?
  languages     String  @default("English, Hindi")
  bio           String?
  offersHomeVisit Boolean @default(true)
  offersClinic    Boolean @default(true)
  offersVideo     Boolean @default(false)
  isVerified    Boolean @default(false)
  avgRating     Float   @default(0)
  totalReviews  Int     @default(0)
  bankDetails   String?
  // Set on every bank-details change — admins see a recent change before paying out.
  bankDetailsUpdatedAt DateTime?
  status        String  @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED

  registrationFeePaid   Boolean @default(false)
  registrationFeeStatus String  @default("PENDING") // PENDING, PAID
  // What the registration order in cashfreeOrderId was created for (fee −
  // coupon) — the webhook checks the payment against this, so the admin
  // changing the fee mid-checkout can't reject a real payment.
  registrationOrderAmount Float?
  medRegCertUrl         String?
  degreeCertUrl         String?
  kycDocUrl             String?
  signatureUrl          String?
  address               String?
  clinicName            String?
  clinicPhotoUrl        String?
  cashfreeOrderId       String?
  cashfreePaymentId     String?
  trialEndsAt           DateTime?
  subscriptionPaidUntil DateTime?
}

// A receptionist/front-desk account created by a doctor, scoped to that one
// doctor's appointment queue only (accept/reject/cancel/no-show) — no
// earnings, payouts, or profile access. See src/lib/staffGuard.ts.
model NurseProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl         String?
  qualification    String? // ANM, GNM, B.Sc Nursing, M.Sc Nursing
  councilRegNo     String? @unique // Nursing Council registration number
  councilState     String?
  experience       Int     @default(0)
  gender           String? // Male, Female, Other — patients can filter for a female nurse
  languages        String  @default("Marathi, Hindi, English")
  bio              String?
  radius           Int     @default(10) // km the nurse will travel for a home visit
  lat              Float?
  lng              Float?
  address          String?
  availability     String  @default("Mon-Sat, 8AM-8PM")
  isVerified       Boolean @default(false)
  avgRating        Float   @default(0)
  totalReviews     Int     @default(0)
  bankDetails      String?
  status           String  @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  councilCertUrl   String?
  degreeCertUrl    String?
  kycDocUrl        String?
  policeVerifUrl   String?
  registrationFeePaid   Boolean   @default(false)
  subscriptionPaidUntil DateTime?
  cashfreeOrderId       String?
  cashfreePaymentId     String?
  // Admin can change the nurse fees at any time, so the webhook checks the
  // payment against the amount this order was actually created for.
  pendingOrderAmount    Float?
  createdAt        DateTime @default(now())
  services         NurseServiceOffering[]
}

// Admin-managed catalogue of nurse services (like Specialty for doctors).
model NurseService {
  id                   String   @id @default(cuid())
  name                 String   @unique
  // VISIT = a procedure/visit (minutes); SHIFT = the nurse stays for
  // durationMinutes (12h / 24h attendant care). Shifts skip the nurse's
  // daily working hours but still block her calendar for their full length.
  kind                 String   @default("VISIT") // VISIT, SHIFT
  description          String?
  durationMinutes      Int      @default(30)
  suggestedPrice       Float    @default(0)
  requiresPrescription Boolean  @default(false) // injections/IV need a doctor's prescription
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  offerings            NurseServiceOffering[]
  appointments         Appointment[]
  referrals            NurseReferral[]
}

// Vitals a nurse records during a visit (BP, pulse, SpO2, temperature, sugar).
// The subject is the account holder, or one of their family members.
model VitalReading {
  id            String    @id @default(cuid())
  patientId     String
  patient       User      @relation("PatientVitals", fields: [patientId], references: [id], onDelete: Cascade)
  dependentId   String?
  dependent     PatientDependent? @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recordedById  String
  recordedBy    User      @relation("VitalsRecordedBy", fields: [recordedById], references: [id])
  recordedAt    DateTime  @default(now())
  systolic      Int?
  diastolic     Int?
  pulse         Int?
  spo2          Int?
  temperatureC  Float?
  sugarMgDl     Int?
  sugarType     String?   // FASTING, RANDOM, POST_MEAL
  notes         String?
  alertLevel    String    @default("NORMAL") // NORMAL, WARNING, CRITICAL
  alerts        String?   // readable summary of what was out of range

  @@index([patientId, dependentId, recordedAt])
}

model NursePackage {
  id           String   @id @default(cuid())
  patientId    String
  nurseId      String
  serviceId    String
  visits       Int
  intervalDays Int      @default(1)
  createdAt    DateTime @default(now())
  appointments Appointment[]
}

// "Nurse care needed" written by a doctor while completing a consultation.
model NurseReferral {
  id            String       @id @default(cuid())
  appointmentId String       @unique
  appointment   Appointment  @relation("ReferralSource", fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       NurseService @relation(fields: [serviceId], references: [id])
  visits        Int          @default(1)
  intervalDays  Int          @default(1)
  instructions  String?
  createdAt     DateTime     @default(now())
  bookings      Appointment[] @relation("ReferralBookings")
}

// Which services a nurse offers, at the nurse's own price.
model NurseServiceOffering {
  id             String       @id @default(cuid())
  nurseProfileId String
  nurseProfile   NurseProfile @relation(fields: [nurseProfileId], references: [id], onDelete: Cascade)
  serviceId      String
  service        NurseService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price          Float

  @@unique([nurseProfileId, serviceId])
}

model NursePaymentLog {
  id                String   @id @default(cuid())
  nurseId           String
  nurse             User     @relation("NursePaymentLogs", fields: [nurseId], references: [id])
  type              String   // REGISTRATION, SUBSCRIPTION
  amount            Float
  cashfreePaymentId String?
  createdAt         DateTime @default(now())
}

// A verified doctor's request to change a field the verification vouched
// for (medRegNo, qualification, specialty). The live profile keeps the old
// values until an admin approves; at most one PENDING per doctor — a new
// edit is merged into it. `changes` is { field: { from, to } }.
model DoctorChangeRequest {
  id           String    @id @default(cuid())
  doctorId     String
  doctor       User      @relation("DoctorChangeRequests", fields: [doctorId], references: [id], onDelete: Cascade)
  changes      Json
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewNote   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ChangeRequestsResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([doctorId, status])
}

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("StaffAccount", fields: [userId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User     @relation("DoctorStaff", fields: [doctorId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Appointment {
  id            String    @id @default(cuid())
  patientId     String
  patient       User      @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId      String
  doctor        User      @relation("DoctorAppointments", fields: [doctorId], references: [id])
  symptoms      String
  patientName   String?
  relation      String    @default("Self")
  allergies     String?
  dependentId   String?
  dependent     PatientDependent? @relation(fields: [dependentId], references: [id])
  consentGiven  Boolean   @default(false)
  consultType   String    @default("CLINIC") // CLINIC, HOME, VIDEO
  // Who the booking is with. Nurse bookings reuse this whole table (and the
  // payment/wallet/settlement/review machinery keyed on doctorId) — doctorId
  // then holds the nurse's user id. Nurse visits are always consultType HOME.
  providerType  String    @default("DOCTOR") // DOCTOR, NURSE
  nurseServiceId String?
  nurseService   NurseService? @relation(fields: [nurseServiceId], references: [id], onDelete: SetNull)
  serviceName    String?   // denormalised so it survives the service being renamed/removed
  prescriptionDocId String?
  prescriptionDoc   PatientDocument? @relation("NurseBookingPrescription", fields: [prescriptionDocId], references: [id], onDelete: SetNull)
  // Visit-start code (nurse visits): generated when the nurse accepts, shown
  // only to the patient; the nurse must enter it at the door to start the
  // visit. Starting without it needs a reason (visitStartNote) and is
  // flagged for the admin.
  visitOtp          String?
  visitOtpAttempts  Int       @default(0)
  visitStartedAt    DateTime?
  visitStartNote    String?
  // Multi-visit nurse package: every visit is its own appointment (own
  // travel / start / completion / refund) grouped by packageId, paid once.
  packageId         String?
  package           NursePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageIndex      Int?      // 1-based visit number within the package
  // Nurse booking made from a doctor's referral — the referral's
  // prescription stands in for an uploaded one.
  nurseReferralId   String?
  nurseReferral     NurseReferral? @relation("ReferralBookings", fields: [nurseReferralId], references: [id], onDelete: SetNull)
  // On a doctor's consultation: the nurse care the doctor recommended.
  referralGiven     NurseReferral? @relation("ReferralSource")
  vitals            VitalReading[]
  status        String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, SCHEDULED, REJECTED, EXPIRED, COMPLETED, CANCELLED, NO_SHOW
  acceptedAt    DateTime? // set when the doctor accepts (PENDING_APPROVAL → SCHEDULED); used for the late-cancellation warning
  videoStartedPushAt DateTime? // set when the "video consultation started" push goes out — once per appointment
  completedAt   DateTime? // set when marked COMPLETED; starts the prescription edit window (src/lib/prescriptionLock.ts). Null on rows completed before it existed
  paymentMethod String    @default("CASH") // ONLINE, CASH
  paymentStatus String    @default("PENDING") // PENDING, PAID
  paidAt        DateTime?
  isEmergency   Boolean   @default(false)
  amount        Float     @default(0)
  platformFee   Float     @default(0)
  // Coupon applied at payment checkout. The platform absorbs the discount:
  // the patient pays `amount - discountAmount`, but the doctor's payout and
  // `platformFee` are still computed off the full `amount`. `couponCode` is
  // denormalised so it survives the coupon row being deleted.
  couponId       String?
  coupon         Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode     String?
  discountAmount Float    @default(0)
  cashfreeOrderId   String?
  cashfreePaymentId String?
  settlementId  String?
  settlement    Settlement? @relation(fields: [settlementId], references: [id])
  prescriptionUrl String? // deprecated — superseded by `attachments`; kept so existing data isn't dropped
  doctorNotes   String?
  travelStatus  String    @default("NOT_STARTED") // NOT_STARTED, ON_THE_WAY, ARRIVED
  // Where a HOME visit happens, copied from the booking — so editing the
  // profile address later never sends the doctor/nurse to the wrong house.
  // Null on CLINIC/VIDEO and on rows booked before the snapshot existed
  // (readers fall back to the profile then; see src/lib/visitAddress.ts).
  visitAddress  String?
  visitLandmark String?
  visitPinCode  String?
  visitLat      Float?
  visitLng      Float?
  doctorLat     Float?
  doctorLng     Float?
  doctorLocationUpdatedAt DateTime?
  followUpOfId  String?
  followUpOf    Appointment? @relation("FollowUp", fields: [followUpOfId], references: [id])
  followUps     Appointment[] @relation("FollowUp")
  // Set on the new appointment created when a doctor cancels an accepted
  // (SCHEDULED) appointment and the system auto-books the nearest other
  // available doctor in its place. The cancelled appointment itself keeps
  // status CANCELLED — `reassignedTo` on it points at the replacement.
  reassignedFromId String?      @unique
  reassignedFrom   Appointment? @relation("Reassignment", fields: [reassignedFromId], references: [id], onDelete: SetNull)
  reassignedTo     Appointment? @relation("Reassignment")
  clinicId      String?
  clinic        Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  scheduledAt   DateTime  @default(now())
  // Patient-requested new time for an accepted (SCHEDULED) appointment. The
  // booking keeps its original scheduledAt — and its payment — until the
  // provider accepts the new time (moves scheduledAt) or keeps the original
  // (clears this). Lapses on its own once either time passes.
  requestedScheduledAt DateTime?
  // Set once the "your appointment is coming up" push has gone out (see
  // src/lib/appointmentReminders.ts), so the periodic sweep never reminds
  // the same appointment twice.
  reminderSentAt DateTime?
  // Last "please pay" push for an unpaid online visit — sent when the
  // provider tries to set off, or taps "Remind to pay" (src/lib/payReminder.ts).
  // Throttled on this, so a patient isn't pushed again within minutes.
  payReminderSentAt DateTime?
  // Set when the doctor or their front desk (STAFF) booked this on the
  // patient's behalf — a walk-in or phone-in (/doctor/walk-in) — to the id
  // of whoever entered it. Null for everything the patient booked.
  bookedById    String?
  createdAt     DateTime  @default(now())
  review        Review?
  medicines     PrescriptionMedicine[]
  tests         PrescriptionTest[]
  attachments   PrescriptionAttachment[]
  prescriptionVersions PrescriptionVersion[]
  messages      Message[]
  walletTransaction WalletTransaction?
  paymentOrderItems PaymentOrderItem[]
  couponRedemption  CouponRedemption?

  // /api/appointments/me pages and polls by owner + visit time (src/lib/appointmentFeed.ts).
  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id                String       @id @default(cuid())
  walletId          String
  wallet            Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type              String       // TOPUP, BOOKING_PAYMENT, ADMIN_CREDIT, ADMIN_DEBIT, REASSIGNMENT_CREDIT, CANCELLATION_REFUND, PAYMENT_CREDIT
  amount            Float        // always positive; direction implied by `type`
  balanceAfter      Float?       // wallet.balance immediately after this row settled; null until status = SUCCESS
  status            String       @default("SUCCESS") // PENDING, SUCCESS, FAILED — only TOPUP rows are ever created PENDING
  appointmentId     String?      @unique // set for BOOKING_PAYMENT rows
  // Set on the CANCELLATION_REFUND / REASSIGNMENT_CREDIT row that refunds an
  // appointment — unique, so concurrent cancels can never refund it twice.
  refundOfAppointmentId String?  @unique
  // Set on the PAYMENT_CREDIT row for a gateway payment that couldn't (fully)
  // be applied — unique, so a webhook retry or a racing verify-order can
  // never credit the same payment twice.
  creditOfPaymentId String?      @unique
  appointment       Appointment? @relation(fields: [appointmentId], references: [id])
  cashfreeOrderId   String?      // set for TOPUP rows
  cashfreePaymentId String?
  adminId           String?      // set for ADMIN_CREDIT/ADMIN_DEBIT rows
  admin             User?        @relation("WalletAdjustedBy", fields: [adminId], references: [id])
  note              String?      // admin adjustment reason
  createdAt         DateTime     @default(now())
}

model Settlement {
  id               String   @id @default(cuid())
  doctorId         String
  doctor           User     @relation("DoctorSettlements", fields: [doctorId], references: [id])
  cashCount        Int      @default(0)
  onlineCount      Int      @default(0)
  cashFeeOwed      Float    @default(0) // owed BY doctor TO platform
  onlinePayoutOwed Float    @default(0) // owed TO doctor BY platform
  netAmount        Float    // onlinePayoutOwed - cashFeeOwed
  note             String?
  // Client-generated per "Settle" click (reused on retry / the negative-net
  // acknowledgement), so a double-submit returns this settlement, not a second one.
  idempotencyKey   String?  @unique
  settledByAdminId String?
  settledByAdmin   User?    @relation("AdminSettlements", fields: [settledByAdminId], references: [id])
  createdAt        DateTime @default(now())
  appointments     Appointment[]
  payoutRequests   PayoutRequest[]
  duesPayment      DuesPayment?
}

// A doctor's own request to be paid out — settlement is still an admin
// action (POST /api/admin/finance/settlements), this just lets a doctor flag
// "please settle me" instead of waiting for the admin to notice on their own.
// `amount` is a snapshot of what was owed at request time (purely
// informational — the actual settlement always recomputes live totals,
// which may have moved on by the time it's fulfilled).
// Time off for a whole provider (doctor or nurse) — every clinic, video and
// home visit — over a range of IST calendar days, both ends included. Unlike
// ClinicLeave (one clinic, one day). No booking can land on these days;
// adding it cancels and refunds what was already there (src/lib/timeOff.ts).
model ProviderTimeOff {
  id         String   @id @default(cuid())
  providerId String
  provider   User     @relation("ProviderTimeOff", fields: [providerId], references: [id], onDelete: Cascade)
  startDate  String   // "YYYY-MM-DD", IST
  endDate    String   // "YYYY-MM-DD", IST, inclusive
  reason     String?
  createdAt  DateTime @default(now())

  @@index([providerId, endDate])
}

// A doctor paying the platform what they owe — the commission on cash
// visits they collected, net of online earnings — through Cashfree
// (/doctor/earnings). The visits it covers are snapshotted when the order is
// created; settling claims exactly those into a Settlement. If any of them
// was settled some other way meanwhile, the payment is kept for the admin to
// review (status PAID, no settlement) rather than applied to the wrong rows.
model DuesPayment {
  id             String      @id @default(cuid())
  orderId        String      @unique // Cashfree order_id, "docdue<doctorId>_<ts>"
  doctorId       String
  doctor         User        @relation("DoctorDuesPayments", fields: [doctorId], references: [id], onDelete: Cascade)
  amount         Float
  appointmentIds String      // JSON array of the covered Appointment ids
  status         String      @default("CREATED") // CREATED, PAID, FAILED
  cfPaymentId    String?
  paidAt         DateTime?
  settlementId   String?     @unique
  settlement     Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@index([doctorId])
}

model PayoutRequest {
  id           String      @id @default(cuid())
  doctorId     String
  doctor       User        @relation("DoctorPayoutRequests", fields: [doctorId], references: [id], onDelete: Cascade)
  amount       Float
  status       String      @default("PENDING") // PENDING, FULFILLED, DISMISSED
  note         String?
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
}

model DoctorPaymentLog {
  id                String   @id @default(cuid())
  doctorId          String
  doctor            User     @relation("DoctorPaymentLogs", fields: [doctorId], references: [id])
  type              String   // REGISTRATION, SUBSCRIPTION
  amount            Float    // amount actually charged (after any coupon discount)
  couponCode        String?
  discountAmount    Float    @default(0)
  cashfreePaymentId String?
  createdAt         DateTime @default(now())
}

model Message {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation("SentMessages", fields: [senderId], references: [id])
  text          String      // may be "" when the message is a file attachment with no caption
  fileUrl       String?
  fileName      String?
  fileType      String?     // MIME type, e.g. "application/pdf", "image/jpeg"
  readAt        DateTime?
  createdAt     DateTime    @default(now())
}

model PrescriptionMedicine {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  name          String
  dosage        String
  frequency     String
  duration      String
  instructions  String?
}

model PrescriptionTest {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  name          String
  instructions  String?
}

// Audit trail of a prescription's medicines + tests: one row per saved change
// (an unchanged re-save adds nothing). Never edited or deleted by the app.
model PrescriptionVersion {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  version       Int         // 1, 2, 3… per appointment
  medicines     Json        // [{ name, dosage, frequency, duration, instructions }]
  tests         Json        // [{ name, instructions }]
  editedById    String      // the doctor's user id (no FK, so history survives account changes)
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, version])
}

model PrescriptionAttachment {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  url           String
  fileName      String?
  createdAt     DateTime    @default(now())
}

model Review {
  id            String      @id @default(cuid())
  patientId     String
  patient       User        @relation("PatientReviews", fields: [patientId], references: [id])
  doctorId      String
  doctor        User        @relation("DoctorReviews", fields: [doctorId], references: [id])
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  rating        Int         // 1–5
  comment       String?
  createdAt     DateTime    @default(now())
}

model Complaint {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt   DateTime @default(now())
}

model Clinic {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    User     @relation("DoctorClinics", fields: [doctorId], references: [id], onDelete: Cascade)
  name      String
  address   String
  photoUrl  String?
  lat       Float
  lng       Float
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  // Soft delete: set together with isActive = false, so every patient-facing
  // query (they all filter isActive) hides it, while past appointments keep
  // their clinic name/address. Only the doctor's own lists filter on this.
  deletedAt DateTime?
  createdAt DateTime @default(now())

  slots        ClinicSlot[]
  leaves       ClinicLeave[]
  appointments Appointment[]
}

model ClinicSlot {
  id        String @id @default(cuid())
  clinicId  String
  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  dayOfWeek String // Mon, Tue, Wed, Thu, Fri, Sat, Sun
  fromTime  String // "HH:MM", 24h
  toTime    String // "HH:MM", 24h
}

// A single calendar date this clinic is closed despite its normal weekly
// ClinicSlot hours — a doctor's day off, holiday, vacation day, etc. Plain
// "YYYY-MM-DD" string (not DateTime) to match how every other date in
// src/lib/clinicAvailability.ts is handled — a calendar date, not an instant.
model ClinicLeave {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  reason    String?
  createdAt DateTime @default(now())

  @@unique([clinicId, date])
}

model Specialty {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#2563eb")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Announcement {
  id              String    @id @default(cuid())
  title           String
  message         String
  bannerImageUrl  String?
  buttons         Json?     // [{ label: string, url: string }], max 2 — enforced in API layer
  audience        String    // DOCTOR, PATIENT, BOTH
  status          String    @default("DRAFT") // DRAFT, SENT
  createdByUserId String
  createdBy       User      @relation("AnnouncementsCreated", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sentAt          DateTime?

  recipients AnnouncementRecipient[]
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("AnnouncementRecipients", fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt    DateTime     @default(now()) // row creation = fan-out time at Send
  seenAt         DateTime?

  @@unique([announcementId, userId])
  @@index([userId, seenAt])
}

model ImpersonationLog {
  id           String    @id @default(cuid())
  adminId      String
  admin        User      @relation("ImpersonationsStarted", fields: [adminId], references: [id])
  targetUserId String
  targetUser   User      @relation("ImpersonationsReceived", fields: [targetUserId], references: [id])
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
}

model PlatformSettings {
  id                      String   @id @default(cuid())
  clinicCommissionPercent Float    @default(10)
  videoCommissionPercent  Float    @default(10)
  homeCommissionPercent   Float    @default(10)
  // Nurses — all admin-set. A fee of 0 means "free": no payment step at
  // registration / no monthly subscription gate.
  nurseCommissionPercent  Float    @default(10)
  nurseRegistrationFee    Float    @default(0)
  // Doctors' one-time registration fee (₹0 = free: activated without a
  // payment step) — read by checkout, coupons and the approve gate
  // (src/lib/doctorFees.ts). The monthly subscription is still a constant.
  doctorRegistrationFee   Float    @default(99)
  nurseSubscriptionFee    Float    @default(0)
  // One-time: the starter 12h/24h shift services were added to an existing
  // catalogue (so an admin deleting them later doesn't bring them back).
  nurseShiftServicesSeeded Boolean @default(false)
  // How far ahead a patient can book or reschedule (doctor and nurse), in
  // days — see src/lib/bookingLimits.ts.
  bookingHorizonDays      Int      @default(60)
  // Days after a visit is completed that patient and provider can still send
  // chat messages (0 = read-only right away) — see src/lib/chatAccess.ts.
  chatFollowUpDays        Int      @default(7)
  // Most a doctor may owe in commission on cash visits (net of their online
  // earnings) before new cash bookings from their side are refused until
  // they pay it (src/lib/duesPayments.ts). ₹0 = no limit.
  cashDueLimit            Float    @default(2000)
  // Mobile app splash: admin uploads an image that the native shell shows over
  // the WebView while it boots (the real native splash is baked into the app
  // binary and can't change without a store update — this is the dynamic layer
  // on top). splashFit: "cover" (full-bleed) or "contain" (centred logo on
  // splashBgColor). See SplashOverlay.tsx / /api/app-config.
  splashImageUrl          String?
  splashFit               String   @default("cover") // "cover", "contain"
  splashBgColor           String   @default("#F8FAFC")
  updatedAt               DateTime @updatedAt
}

// Promotional discount code, created by an admin and applied by a patient at
// payment checkout. See src/lib/coupons.ts and /api/coupons/apply.
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique // stored UPPERCASE
  description    String?
  discountType   String   @default("PERCENT") // PERCENT, FLAT
  discountValue  Float     // percent (0-100) or rupee amount
  maxDiscount    Float?    // cap in rupees, only meaningful for PERCENT
  minAmount      Float    @default(0) // minimum base amount to qualify
  // What this coupon can be used for — CSV of APPOINTMENT, DOCTOR_REGISTRATION,
  // DOCTOR_SUBSCRIPTION. Empty/null is treated as APPOINTMENT only.
  appliesTo      String   @default("APPOINTMENT")
  consultTypes   String?  // CSV of CLINIC,VIDEO,HOME — null/empty means all (APPOINTMENT only)
  maxRedemptions Int?     // total cap across all users — null means unlimited
  perUserLimit   Int      @default(1)
  // Reserved+confirmed slot counter. Incremented atomically when a patient
  // applies the coupon, decremented if they remove it or the appointment is
  // cancelled unpaid. Guards `maxRedemptions` without a race.
  usedCount      Int      @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean  @default(true)
  createdByAdminId String?
  createdByAdmin   User?  @relation("CouponsCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redemptions    CouponRedemption[]
  appointments   Appointment[]
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Exactly one of these identifies what the coupon was used on:
  //  - appointmentId for a patient booking payment (kind APPOINTMENT)
  //  - orderId (the Cashfree order id) for a doctor registration/subscription fee
  kind          String   @default("APPOINTMENT") // APPOINTMENT, DOCTOR_REGISTRATION, DOCTOR_SUBSCRIPTION
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  orderId       String?  @unique
  discountAmount Float
  status        String   @default("RESERVED") // RESERVED, CONFIRMED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// One Cashfree checkout for one or more appointments (a nurse package's
// visits share one order). Kept per order instead of overwriting
// Appointment.cashfreeOrderId, so a payment that lands on an older order — or
// a second payment for something already paid — can still be traced and
// credited to the patient's wallet. Settled by src/lib/paymentOrders.ts.
model PaymentOrder {
  id          String   @id @default(cuid())
  orderId     String   @unique // Cashfree order_id
  patientId   String
  patient     User     @relation("PatientPaymentOrders", fields: [patientId], references: [id])
  amount      Float    // order_amount sent to Cashfree
  status      String   @default("CREATED") // CREATED, PAID, PARTIAL (some items credited), CREDITED (all to wallet)
  cfPaymentId String?  // the payment that settled it
  settledAt   DateTime?
  createdAt   DateTime @default(now())
  items       PaymentOrderItem[]

  @@index([patientId])
}

model PaymentOrderItem {
  id             String       @id @default(cuid())
  paymentOrderId String
  paymentOrder   PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  appointmentId  String
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount         Float        // this appointment's share when the order was created
  outcome        String?      // APPLIED (marked PAID) or CREDITED (sent to wallet); null until settled

  @@unique([paymentOrderId, appointmentId])
  @@index([appointmentId])
}
