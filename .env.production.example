# Copy this to `.env.production` on the server and fill in real values.
# Never commit the real `.env.production` file.

POSTGRES_USER=doconclick
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=doconclick_db

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Google OAuth (Sign in with Google) — from Google Cloud Console > APIs &
# Services > Credentials. Register this redirect URI there:
# https://doconclick.co.in/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browsers drop `Secure` cookies on plain HTTP. Leave this as `false` while
# serving over http://<ec2-ip> with no domain/TLS. Once you add a domain +
# HTTPS (nginx + Let's Encrypt), remove this line so cookies default back
# to Secure.
COOKIE_SECURE=false

# Cashfree Payment Gateway — https://merchant.cashfree.com/merchants/pg/developers/api-keys
# Register this webhook URL in the Cashfree dashboard:
# https://doconclick.co.in/api/payments/webhook
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production — server-side only (order creation). The client-side
# checkout SDK mode is hardcoded to "production" in the payment page instead
# of an env var, since NEXT_PUBLIC_ vars are inlined at Docker *build* time,
# not container runtime, so env_file: .env.production can't toggle it anyway.
# If you add sandbox testing later, wire it as a Docker build ARG.
CASHFREE_ENV=production

# AWS S3 — stores patient/doctor photos, KYC & verification documents, and
# prescription attachments. Bucket must allow public GetObject (see setup
# notes) since uploaded file URLs are served directly from S3.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Agora — powers video consultations. Free project at https://console.agora.io
# (App ID / App Certificate under Project Management).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# OpenAI — powers the patient Health Assistant chat.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

