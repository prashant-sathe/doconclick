# Copy this to `.env.production` on the server and fill in real values.
# Never commit the real `.env.production` file.

POSTGRES_USER=doconclick
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=doconclick_db

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Google OAuth (Sign in with Google) — from Google Cloud Console > APIs &
# Services > Credentials.
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: the "Web application" OAuth client.
# Register this redirect URI on it (exactly — no trailing slash, no www):
#   https://doconclick.co.in/api/auth/google/callback
# and this Authorized JavaScript origin:
#   https://doconclick.co.in
# The web OAuth flow is pinned to one canonical origin so only this single
# URI needs registering (see GOOGLE_OAUTH_ORIGIN below and oauthCanonicalOrigin).
# The web client ID is also the audience the native mobile ID tokens are
# verified against (Android reports it as `aud`; see /api/auth/google/native).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. The canonical origin the browser Google-sign-in flow runs on.
# Defaults to https://doconclick.co.in (from src/lib/seo.ts). Set this only if
# the site's real canonical host differs (e.g. a www. canonical, or a staging
# domain). Must exactly match one Authorized redirect URI's origin in the
# Google Cloud Console.
# GOOGLE_OAUTH_ORIGIN=https://doconclick.co.in

# Native mobile Google Sign-In (@capgo/capacitor-social-login) — same Google
# Cloud project as GOOGLE_CLIENT_ID.
#   GOOGLE_CLIENT_ID_ANDROID: "Android" OAuth client (package com.doconclick.app
#     + the app's signing SHA-1 fingerprints — debug, release, Play App Signing).
#   GOOGLE_CLIENT_ID_IOS:     "iOS" OAuth client (bundle ID com.doconclick.app).
# Both are accepted as ID-token audiences by /api/auth/google/native.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# Client-side copies the native account picker needs in the browser bundle.
# Public identifiers, not secrets. NEXT_PUBLIC_ vars are baked in at Docker
# *build* time via build args, not container runtime (see NEXT_PUBLIC_FIREBASE_*).
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID     = the Web client ID (used on Android + web)
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID_IOS = the iOS client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID_IOS=

# Browsers drop `Secure` cookies on plain HTTP. Leave this as `false` while
# serving over http://<ec2-ip> with no domain/TLS. Once you add a domain +
# HTTPS (nginx + Let's Encrypt), remove this line so cookies default back
# to Secure.
COOKIE_SECURE=false

# Cashfree Payment Gateway — https://merchant.cashfree.com/merchants/pg/developers/api-keys
# Register this webhook URL in the Cashfree dashboard:
# https://doconclick.co.in/api/payments/webhook
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production — server-side only (order creation). The client-side
# checkout SDK mode is hardcoded to "production" in the payment page instead
# of an env var, since NEXT_PUBLIC_ vars are inlined at Docker *build* time,
# not container runtime, so env_file: .env.production can't toggle it anyway.
# If you add sandbox testing later, wire it as a Docker build ARG.
CASHFREE_ENV=production

# Firebase (push notifications). Service account: Firebase console > Project
# settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web app config (client-side) — Project settings > General > Your
# apps > Web app. NEXT_PUBLIC_FIREBASE_VAPID_KEY is separate: Project settings
# > Cloud Messaging > Web configuration > Web Push certificates. Public
# identifiers, not secrets. NEXT_PUBLIC_ vars only take effect via Docker
# build args (see docker-compose.prod.yml's `app.build.args`) — exporting
# them here has no effect on the running container, only on `compose build`.
# The same 6 values (all but VAPID_KEY) must also be copied literally into
# public/firebase-messaging-sw.js.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# AWS S3 — stores patient/doctor photos, KYC & verification documents, and
# prescription attachments. Bucket must allow public GetObject (see setup
# notes) since uploaded file URLs are served directly from S3.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Agora — powers video consultations. Free project at https://console.agora.io
# (App ID / App Certificate under Project Management).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# OpenAI — powers the patient Health Assistant chat.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

