<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) system Splash Screen API. This style fully
         replaces the one in values/styles.xml on API 31+ (styles don't merge
         across resource qualifiers), so every windowSplashScreen* item is
         repeated here.

         The branded splash is the dynamic, admin-uploaded overlay rendered by
         the WebView (SplashOverlay.tsx), so this OS splash is kept as bare as
         the platform allows: just the launcher icon on the app background
         colour, and NO branding wordmark (that made it look like a second,
         separate splash screen). The icon itself can't be removed on Android
         12+ — the OS always draws it during the launch animation. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen.IconBackground">
        <item name="android:background">@color/splashBackground</item>
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <!-- Invisible icon (solid #F8FAFC fill) so the mandatory OS splash
             renders as a plain background screen. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splashBackground</item>
    </style>
</resources>
