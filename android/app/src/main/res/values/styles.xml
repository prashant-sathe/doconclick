<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen.IconBackground">
        <!-- Plain colour, not a logo drawable: the branded splash is the
             dynamic (admin-uploaded) overlay rendered by the WebView
             (SplashOverlay.tsx). Showing a logo here too made it look like
             two separate splash screens. -->
        <item name="android:background">@color/splashBackground</item>
        <!-- Android 12+ (API 31+) uses the real system Splash Screen API instead
             of the drawable above, and shows only the launcher icon unless these
             are set explicitly. The branding image (wordmark under the icon) is
             a real platform attribute with no compat-library wrapper, so it's
             set via android:windowSplashScreenBrandingImage in values-v31 instead. -->
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <!-- Invisible icon: the only branded splash is the dynamic overlay
             (SplashOverlay.tsx). Android 12+ won't let the system splash be
             removed, so it's rendered as a plain #F8FAFC screen instead. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splashBackground</item>
    </style>
</resources>